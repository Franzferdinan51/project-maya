# Embed the MSL kernel library source into a generated header as a byte array.
# Inputs: KERNEL_DIR (holds common.metalh + *.metal), OUT (header path to write).
# The library source is common.metalh first, then every *.metal in name order - the
# concatenation order the dispatch contract promises. A byte array sidesteps every
# C-string escaping question the MSL source could raise.
file(GLOB _metals "${KERNEL_DIR}/*.metal")
list(SORT _metals)
set(_files "${KERNEL_DIR}/common.metalh" ${_metals})
set(_hex "")
foreach(_f IN LISTS _files)
  file(READ "${_f}" _one HEX)
  set(_hex "${_hex}${_one}")
endforeach()
string(REGEX REPLACE "(..)" "0x\\1," _bytes "${_hex}")
file(WRITE "${OUT}"
"// Generated by cmake/embed_metal_kernels.cmake - do not edit.\n"
"static const unsigned char kMetalKernelsSource[] = {${_bytes}};\n"
"static const unsigned long kMetalKernelsSourceLen = sizeof(kMetalKernelsSource);\n")
