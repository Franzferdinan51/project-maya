// common.metalh - shared prelude for the Metal Qwen backend's MSL library. The
// runtime prepends this file to every src/metal-qwen/kernels/*.metal file and
// compiles the concatenation once; each .metal file is self-contained apart from
// this prelude. Contents: number-format helpers and the ggml block dequantizer
// used by the dense family (transcribed from the tree's own CUDA dequantizers
// and the src/artifact scalar reference, which agree element for element).

#include <metal_stdlib>
using namespace metal;

inline float dq_h2f(ushort bits) { return float(as_type<half>(bits)); }
inline float dq_bf2f(ushort bits) { return as_type<float>(uint(bits) << 16); }
inline ushort dq_f2h(float f) { return as_type<ushort>(half(f)); }
inline ushort dq_f2bf(float f) {
    uint u = as_type<uint>(f);
    u += 0x7fffu + ((u >> 16) & 1u);  // round to nearest even, as the CUDA TU
    return ushort(u >> 16);
}
inline ushort dq_ld16(device const uchar* p) { return ushort(p[0]) | (ushort(p[1]) << 8); }
inline uint dq_ld32(device const uchar* p) {
    return uint(p[0]) | (uint(p[1]) << 8) | (uint(p[2]) << 16) | (uint(p[3]) << 24);
}
inline float dq_ldf16(device const uchar* p) { return dq_h2f(dq_ld16(p)); }

constant float kIq4NlF[16] = {-127.f, -104.f, -83.f, -65.f, -49.f, -35.f, -22.f, -10.f,
                              1.f,    13.f,   25.f,  38.f,  53.f,  69.f,  89.f,  113.f};

// One element of a ggml block row. `row` points at the row's first block byte,
// `type` is the ggml type id, `e` the element index inside the row. Covers the
// formats dequant_bf16 / native_mmvq / iq share: Q4_0 (2), Q5_0 (6), Q8_0 (8),
// Q3_K (11), Q4_K (12), Q5_K (13), Q6_K (14), IQ4_NL (20), IQ4_XS (23), Q2_0 (42).
// IQ3_XXS codebook + sign tables (ggml's constant tables, transcribed as data).
constant uint kIq3XxsGrid[256] = {
