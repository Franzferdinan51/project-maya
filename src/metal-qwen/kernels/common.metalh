constant uchar kKsignsIq2xs[128] = {
    0u, 129u, 130u, 3u, 132u, 5u, 6u, 135u, 136u, 9u, 10u, 139u, 12u, 141u, 142u, 15u,
    144u, 17u, 18u, 147u, 20u, 149u, 150u, 23u, 24u, 153u, 154u, 27u, 156u, 29u, 30u, 159u,
    160u, 33u, 34u, 163u, 36u, 165u, 166u, 39u, 40u, 169u, 170u, 43u, 172u, 45u, 46u, 175u,
    48u, 177u, 178u, 51u, 180u, 53u, 54u, 183u, 184u, 57u, 58u, 187u, 60u, 189u, 190u, 63u,
    192u, 65u, 66u, 195u, 68u, 197u, 198u, 71u, 72u, 201u, 202u, 75u, 204u, 77u, 78u, 207u,
    80u, 209u, 210u, 83u, 212u, 85u, 86u, 215u, 216u, 89u, 90u, 219u, 92u, 221u, 222u, 95u,
    96u, 225u, 226u, 99u, 228u, 101u, 102u, 231u, 232u, 105u, 106u, 235u, 108u, 237u, 238u, 111u,
    240u, 113u, 114u, 243u, 116u, 245u, 246u, 119u, 120u, 249u, 250u, 123u, 252u, 125u, 126u, 255u,
};
constant uchar kKmaskIq2xs[8] = { 1u, 2u, 4u, 8u, 16u, 32u, 64u, 128u };

inline float dq_elem(device const uchar* row, int type, uint e) {
    if (type == 42) {  // Q2_0: 64 elements, 18-byte block {f16 d, qs[16]}
        device const uchar* b = row + (e / 64) * 18;
        uint j = e % 64;
        int code = (b[2 + j / 4] >> ((j % 4) * 2)) & 3;
        return float(code - 1) * dq_ldf16(b);
    }
    if (type == 2) {  // Q4_0: 32 elements, 18-byte block
        device const uchar* b = row + (e / 32) * 18;
        uint j = e % 32;
        int nib = (j < 16) ? (b[2 + j] & 0xF) : (b[2 + j - 16] >> 4);
        return float(nib - 8) * dq_ldf16(b);
    }
    if (type == 6) {  // Q5_0: 32 elements, 22-byte block {f16 d, qh[4], qs[16]}
        device const uchar* b = row + (e / 32) * 22;
        uint j = e % 32;
        uint qh = uint(b[2]) | (uint(b[3]) << 8) | (uint(b[4]) << 16) | (uint(b[5]) << 24);
        int x = (j < 16) ? int((b[6 + j] & 0xF) | (((qh >> j) << 4) & 0x10))
                         : int((b[6 + j - 16] >> 4) | (((qh >> (j - 4)) & 0x10)));
        return float(x - 16) * dq_ldf16(b);
    }
    if (type == 8) {  // Q8_0: 32 elements, 34-byte block
        device const uchar* b = row + (e / 32) * 34;
        return float(int(char(b[2 + (e % 32)]))) * dq_ldf16(b);
    }
    if (type == 20) {  // IQ4_NL: 32 elements, 18-byte block
        device const uchar* b = row + (e / 32) * 18;
        uint j = e % 32;
        int nib = (j < 16) ? (b[2 + j] & 0xF) : (b[2 + j - 16] >> 4);
        return dq_ldf16(b) * kIq4NlF[nib];
    }
    if (type == 11) {  // Q3_K: 256 elements, 110-byte super-block
        device const uchar* b = row + (e / 256) * 110;
        uint w = e % 256, gi = w / 32, t = w % 32, n = gi / 4, jj = gi % 4;
        // repack the 12 scale bytes into 16 six-bit scales, as the reference does
        uint aux0 = uint(b[96]) | (uint(b[97]) << 8) | (uint(b[98]) << 16) | (uint(b[99]) << 24);
        uint aux1 = uint(b[100]) | (uint(b[101]) << 8) | (uint(b[102]) << 16) | (uint(b[103]) << 24);
        uint aux2 = uint(b[104]) | (uint(b[105]) << 8) | (uint(b[106]) << 16) | (uint(b[107]) << 24);
        uint sc[4];
        sc[2] = ((aux0 >> 4) & 0x0f0f0f0fu) | (((aux2 >> 4) & 0x03030303u) << 4);
        sc[3] = ((aux1 >> 4) & 0x0f0f0f0fu) | (((aux2 >> 6) & 0x03030303u) << 4);
        sc[0] = (aux0 & 0x0f0f0f0fu) | (((aux2 >> 0) & 0x03030303u) << 4);
        sc[1] = (aux1 & 0x0f0f0f0fu) | (((aux2 >> 2) & 0x03030303u) << 4);
        uint is = n * 8 + jj * 2 + (t >= 16 ? 1 : 0);
        int scale = int(char((sc[is / 4] >> ((is % 4) * 8)) & 0xFF));
        float dl = dq_ldf16(b + 108) * float(scale - 32);
        uint shift = 2 * jj;
        uint m = 1u << (n * 4 + jj);
        int q = int((b[32 + n * 32 + t] >> shift) & 3) - ((b[t] & m) ? 0 : 4);
        return dl * float(q);
    }
    if (type == 12 || type == 13) {  // Q4_K (144 B) / Q5_K (176 B) super-blocks
        bool k5 = (type == 13);
        device const uchar* b = row + (e / 256) * (k5 ? 176 : 144);
        uint w = e % 256, gi = w / 32, j64 = gi / 2, hi = gi % 2, l = w % 32;
        int sc, mn;
        if (gi < 4) {
            sc = b[4 + gi] & 63;
            mn = b[4 + gi + 4] & 63;
        } else {
            sc = (b[4 + gi + 4] & 0xF) | ((b[4 + gi - 4] >> 6) << 4);
            mn = (b[4 + gi + 4] >> 4) | ((b[4 + gi] >> 6) << 4);
        }
        float d1 = dq_ldf16(b) * float(sc);
        float m1 = dq_ldf16(b + 2) * float(mn);
        if (!k5) {
            device const uchar* q = b + 16 + 32 * j64;
            int nib = hi ? (q[l] >> 4) : (q[l] & 0xF);
            return d1 * float(nib) - m1;
        }
        device const uchar* ql = b + 48 + 32 * j64;
        uint u = 1u << (2 * j64 + hi);
        int nib = hi ? (ql[l] >> 4) : (ql[l] & 0xF);
        return d1 * float(nib + ((b[16 + l] & u) ? 16 : 0)) - m1;
    }
    if (type == 14) {  // Q6_K: 256 elements, 210-byte super-block
        device const uchar* b = row + (e / 256) * 210;
        uint w = e % 256, gi = w / 32, n = gi / 4, qu = gi % 4, l = w % 32;
        device const uchar* ql = b + 64 * n;
        device const uchar* qh = b + 128 + 32 * n;
        int q;
        if (qu == 0) q = (ql[l] & 0xF) | (((qh[l] >> 0) & 3) << 4);
        else if (qu == 1) q = (ql[l + 32] & 0xF) | (((qh[l] >> 2) & 3) << 4);
        else if (qu == 2) q = (ql[l] >> 4) | (((qh[l] >> 4) & 3) << 4);
        else q = (ql[l + 32] >> 4) | (((qh[l] >> 6) & 3) << 4);
        int scale = int(char(b[192 + 8 * n + (l / 16) + 2 * qu]));
        return dq_ldf16(b + 208) * float(scale) * float(q - 32);
    }
    if (type == 23) {  // IQ4_XS: 256 elements, 136-byte super-block
        device const uchar* b = row + (e / 256) * 136;
        uint ib = (e % 256) / 32, j = e % 32;
        int ls = ((b[4 + ib / 2] >> (4 * (ib % 2))) & 0xF) | int(((dq_ld16(b + 2) >> (2 * ib)) & 3) << 4);
        float dl = dq_ldf16(b) * float(ls - 32);
        device const uchar* qs = b + 8 + 16 * ib;
        int nib = (j < 16) ? (qs[j] & 0xF) : (qs[j - 16] >> 4);
        return dl * kIq4NlF[nib];
    }
    if (type == 18) {  // IQ3_XXS: 98-byte blocks, grid codebook + packed sign/scale aux
        int ib = (e % 256) / 32, il = (e % 32) / 8, j = e % 8;
        device const uchar* qs = row + (e / 256) * 98 + 2;
        uint grid = kIq3XxsGrid[qs[8 * ib + 2 * il + (j >= 4 ? 1 : 0)]];
        uint aux = dq_ld32(qs + 64 + 4 * ib);
        float d = dq_ldf16(row + (e / 256) * 98) * (0.5f + float(aux >> 28)) * 0.5f;
        uchar signs = kKsignsIq2xs[(aux >> (7 * il)) & 127];
        int gv = int((grid >> (8 * (j % 4))) & 0xFF);
        if (gv >= 128) gv -= 256;
        return d * float(gv) * ((signs & kKmaskIq2xs[j]) ? -1.0f : 1.0f);
    }
    return 0.0f;  // unsupported type: host side validates before launch
}

// ggml block geometry for the dq_elem formats: elements and bytes per block.
inline void dq_geometry(int type, thread uint& elems, thread uint& bytes) {
    switch (type) {
        case 2: elems = 32; bytes = 18; break;
        case 6: elems = 32; bytes = 22; break;
        case 8: elems = 32; bytes = 34; break;
        case 20: elems = 32; bytes = 18; break;
        case 11: elems = 256; bytes = 110; break;
        case 12: elems = 256; bytes = 144; break;
        case 13: elems = 256; bytes = 176; break;
        case 14: elems = 256; bytes = 210; break;
        case 18: elems = 256; bytes = 98; break;
        case 23: elems = 256; bytes = 136; break;
        case 42: elems = 64; bytes = 18; break;
        default: elems = 0; bytes = 0; break;
    }
}

inline float gdn_sigmoid(float x) { return 1.0f / (1.0f + exp(-x)); }
inline float gdn_silu(float x) { return x / (1.0f + exp(-x)); }
inline float gdn_softplus(float x) { return x > 20.0f ? x : log(1.0f + exp(x)); }
// MSL has no log1p: Kahan form, log(u) * e / (u - 1) with u = 1 + e (exact
// where 1 + e rounds to 1) - the form the reference Metal GDN kernel uses.
inline float gdn_softplus_log1p(float x) {
    if (x > 20.0f) return x;
    float e = exp(x), u = 1.0f + e;
    return u == 1.0f ? e : log(u) * e / (u - 1.0f);
}
inline float bf16_to_f32(ushort h) { return as_type<float>(uint(h) << 16); }
inline ushort f32_to_bf16(float f) {
    uint u = as_type<uint>(f); uint lsb = (u >> 16) & 1u;
    return ushort((u + 0x7FFFu + lsb) >> 16);
}
inline float bf16_round(float f) { return bf16_to_f32(f32_to_bf16(f)); }
// Threadgroup reduction of one float per thread (block <= 1024, power-of-two-ish):
// every thread ends with the total. tg array of 32 floats reused as scratch.
inline float tg_sum(float v, threadgroup float* scratch, uint tid, uint tcount) {
    // simd reduce first
    v = simd_sum(v);
    uint lane = tid & 31u, sg = tid >> 5;
    if (lane == 0u) scratch[sg] = v;
    threadgroup_barrier(mem_flags::mem_threadgroup);
    uint nsg = (tcount + 31u) >> 5;
    v = (tid < nsg) ? scratch[tid] : 0.0f;
    v = simd_sum(v);
    if (tid == 0u) scratch[0] = v;
    threadgroup_barrier(mem_flags::mem_threadgroup);
    return scratch[0];
}
inline float moe_f16_at(device const uchar* p) {
    const ushort bits = ushort(p[0]) | (ushort(p[1]) << 8);
    return float(as_type<half>(bits));
}

// bf16 bits -> float (the bits are the top half of the float).
inline float moe_bf16_to_f32(ushort bits) { return as_type<float>(uint(bits) << 16); }

// Warp reductions in the CUDA xor-butterfly order (mask 16..1), so float sums built on
// them land on the same rounding as the CUDA kernels they mirror.
inline float moe_warp_sum_xor(float v) {
    for (ushort m = 16; m > 0; m >>= 1) v += simd_shuffle_xor(v, m);
    return v;
}
inline float moe_warp_max_xor(float v) {
    for (ushort m = 16; m > 0; m >>= 1) v = max(v, simd_shuffle_xor(v, m));
    return v;
}
inline float strata_f32_from_f16(ushort h) {
    const uint sign = (uint)(h & 0x8000u) << 16;
    const uint ex = (h >> 10) & 0x1fu;
    const uint man = h & 0x3ffu;
    uint out;
    if (ex == 0u) {
        if (man == 0u) {
            out = sign;
        } else {
            uint m = man;
            int s = 0;
            while ((m & 0x400u) == 0u) { m <<= 1u; ++s; }
            out = sign | ((uint)(113 - s) << 23) | ((m & 0x3ffu) << 13);
        }
    } else if (ex == 31u) {
        out = sign | 0x7f800000u | (man << 13);
    } else {
        out = sign | ((ex - 15u + 127u) << 23) | (man << 13);
    }
    return as_type<float>(out);
}
inline ushort strata_f16_from_f32(float f) {
    const uint x = as_type<uint>(f);
    const uint sign = (x >> 16) & 0x8000u;
    const uint rawexp = (x >> 23) & 0xffu;
    int exp = (int)rawexp - 127 + 15;
    uint man = x & 0x7fffffu;
    if (rawexp == 0xffu) return (ushort)(sign | 0x7c00u | (man ? 0x200u : 0u));
    if (exp >= 31) return (ushort)(sign | 0x7c00u);
    if (exp <= 0) {
        if (exp < -10) return (ushort)sign;
        man |= 0x800000u;
        const uint sh = (uint)(14 - exp);
        uint h = (man >> sh) & 0x3ffu;
        const uint rem = man & ((1u << sh) - 1u);
        if (rem > (1u << (sh - 1)) || (rem == (1u << (sh - 1)) && (h & 1u))) ++h;
        return (ushort)(sign | h);
    }
    ushort h = (ushort)(sign | ((uint)exp << 10) | (man >> 13));
    const uint rem = man & 0x1fffu;
    if (rem > 0x1000u || (rem == 0x1000u && (h & 1u))) ++h;
    return h;
}

// ---- M-RoPE position -------------------------------------------------------
// Mirrors mrope_pos in include/strata/kernels/mrope.hpp: with no table the
// rotary position is the position itself; with a table (device int32
// [cells][3] of t/h/w), pair i reads stream (pair % 3). `has_tab` is a kernel
// argument because a null table is passed as a placeholder buffer.
inline int strata_mrope_pos(device const int* tab, int has_tab, int pos, int pair) {
    return has_tab ? tab[pos * 3 + pair % 3] : pos;
}

// ---- total order on scores for selection -----------------------------------
// Mirrors order_key in the CUDA selection kernels: NaN sorts below everything
// (key 0); otherwise the IEEE sign flip makes uint order == float order.
inline uint strata_order_key(float s) {
    const float v = s + 0.0f;
    if (!(v == v)) return 0u;
    const uint b = as_type<uint>(v);
    return (b & 0x80000000u) ? ~b : (b | 0x80000000u);
}

